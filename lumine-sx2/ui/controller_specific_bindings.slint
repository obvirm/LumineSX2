// 4. POP'N MUSIC CONTROLLER BINDING VIEW
// ═══════════════════════════════════════════════
export component PopnBindingView inherits DetailPage {
    title: "Pop'n Music Bindings";

    in-out property <bool> white-l: false;
    in-out property <bool> white-r: false;
    in-out property <bool> yellow-l: false;
    in-out property <bool> yellow-r: false;
    in-out property <bool> green-l: false;
    in-out property <bool> green-r: false;
    in-out property <bool> blue-l: false;
    in-out property <bool> blue-r: false;
    in-out property <bool> red: false;
    in-out property <bool> select-pressed: false;
    in-out property <bool> start-pressed: false;

    in-out property <string> white-l-binding: "";
    in-out property <string> white-r-binding: "";
    in-out property <string> yellow-l-binding: "";
    in-out property <string> yellow-r-binding: "";
    in-out property <string> green-l-binding: "";
    in-out property <string> green-r-binding: "";
    in-out property <string> blue-l-binding: "";
    in-out property <string> blue-r-binding: "";
    in-out property <string> red-binding: "";
    in-out property <string> select-binding: "";
    in-out property <string> start-binding: "";

    callback bind-button(string);
    callback reset-binding(string);

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        Rectangle {
            height: 280px;
            background: MaterialColors.surface-container;
            border-radius: 16px;
            border-width: 1px;
            border-color: MaterialColors.outline;

            VerticalLayout {
                padding: 16px;
                spacing: 14px;
                alignment: center;

                Text { text: "🎵 Pop'n Music Controller"; color: MaterialColors.primary; font-size: 16px; font-weight: 600; horizontal-alignment: center; }

                // Top row: Select + Start
                HorizontalLayout {
                    spacing: 16px;
                    alignment: center;
                    BindingButton { txt: "Select"; button-font-size: 11; binding: select-binding; is-bound: select-binding != ""; pressed: select-pressed; clicked => { select-pressed = !select-pressed; bind-button("select"); } }
                    BindingButton { txt: "Start"; button-font-size: 11; binding: start-binding; is-bound: start-binding != ""; pressed: start-pressed; clicked => { start-pressed = !start-pressed; bind-button("start"); } }
                }

                // Row 1: Yellow L + Yellow R
                HorizontalLayout {
                    spacing: 8px; alignment: center;
                    Rectangle {
                        width: 64px; height: 64px;
                        background: yellow-l || yellow-l-binding != "" ? #fef08a : MaterialColors.surface-container-high;
                        border-radius: 32px;
                        border-width: 3px;
                        border-color: yellow-l-binding != "" ? #eab308 : #a16207;
                        Text { text: "YL"; color: #a16207; font-size: 14px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { yellow-l = !yellow-l; bind-button("yellow_l"); } }
                    }
                    Rectangle {
                        width: 64px; height: 64px;
                        background: yellow-r || yellow-r-binding != "" ? #fef08a : MaterialColors.surface-container-high;
                        border-radius: 32px;
                        border-width: 3px;
                        border-color: yellow-r-binding != "" ? #eab308 : #a16207;
                        Text { text: "YR"; color: #a16207; font-size: 14px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { yellow-r = !yellow-r; bind-button("yellow_r"); } }
                    }
                }

                // Row 2: Blue L + Blue R
                HorizontalLayout {
                    spacing: 8px; alignment: center;
                    Rectangle {
                        width: 64px; height: 64px;
                        background: blue-l || blue-l-binding != "" ? #bfdbfe : MaterialColors.surface-container-high;
                        border-radius: 32px;
                        border-width: 3px;
                        border-color: blue-l-binding != "" ? #3b82f6 : #1e40af;
                        Text { text: "BL"; color: #1e40af; font-size: 14px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { blue-l = !blue-l; bind-button("blue_l"); } }
                    }
                    Rectangle {
                        width: 64px; height: 64px;
                        background: blue-r || blue-r-binding != "" ? #bfdbfe : MaterialColors.surface-container-high;
                        border-radius: 32px;
                        border-width: 3px;
                        border-color: blue-r-binding != "" ? #3b82f6 : #1e40af;
                        Text { text: "BR"; color: #1e40af; font-size: 14px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { blue-r = !blue-r; bind-button("blue_r"); } }
                    }
                }

                // Row 3: Green L + Red (center) + Green R
                HorizontalLayout {
                    spacing: 8px; alignment: center;
                    Rectangle {
                        width: 64px; height: 64px;
                        background: green-l || green-l-binding != "" ? #bbf7d0 : MaterialColors.surface-container-high;
                        border-radius: 32px;
                        border-width: 3px;
                        border-color: green-l-binding != "" ? #22c55e : #166534;
                        Text { text: "GL"; color: #166534; font-size: 14px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { green-l = !green-l; bind-button("green_l"); } }
                    }
                    Rectangle {
                        width: 72px; height: 72px;
                        background: red || red-binding != "" ? #fecaca : MaterialColors.surface-container-high;
                        border-radius: 36px;
                        border-width: 3px;
                        border-color: red-binding != "" ? #ef4444 : #991b1b;
                        Text { text: "R"; color: #991b1b; font-size: 18px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { red = !red; bind-button("red"); } }
                    }
                    Rectangle {
                        width: 64px; height: 64px;
                        background: green-r || green-r-binding != "" ? #bbf7d0 : MaterialColors.surface-container-high;
                        border-radius: 32px;
                        border-width: 3px;
                        border-color: green-r-binding != "" ? #22c55e : #166534;
                        Text { text: "GR"; color: #166534; font-size: 14px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { green-r = !green-r; bind-button("green_r"); } }
                    }
                }

                // Row 4: White L + White R
                HorizontalLayout {
                    spacing: 8px; alignment: center;
                    Rectangle {
                        width: 72px; height: 64px;
                        background: white-l || white-l-binding != "" ? #f5f5f5 : MaterialColors.surface-container-high;
                        border-radius: 8px;
                        border-width: 3px;
                        border-color: white-l-binding != "" ? #9ca3af : #52525b;
                        Text { text: "WL"; color: #52525b; font-size: 14px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { white-l = !white-l; bind-button("white_l"); } }
                    }
                    Rectangle {
                        width: 72px; height: 64px;
                        background: white-r || white-r-binding != "" ? #f5f5f5 : MaterialColors.surface-container-high;
                        border-radius: 8px;
                        border-width: 3px;
                        border-color: white-r-binding != "" ? #9ca3af : #52525b;
                        Text { text: "WR"; color: #52525b; font-size: 14px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { white-r = !white-r; bind-button("white_r"); } }
                    }
                }
            }
        }

        Rectangle {
            height: 40px;
            background: MaterialColors.surface-container;
            border-radius: 8px;
            HorizontalLayout {
                padding-left: 16px; padding-right: 16px; spacing: 8px;
                Text { text: "🎵 Pop'n Music — 11 bindings"; color: MaterialColors.on-surface-variant; font-size: 12px; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Auto Map"; clicked => { } }
                Button {
                    text: "Clear";
                    clicked => {
                        white-l-binding = ""; white-r-binding = ""; yellow-l-binding = ""; yellow-r-binding = "";
                        green-l-binding = ""; green-r-binding = ""; blue-l-binding = ""; blue-r-binding = "";
                        red-binding = ""; select-binding = ""; start-binding = "";
                    }
                }
            }
        }
    }
}

