// 6. GUNCON 2 BINDING VIEW (Light Gun)
// ═══════════════════════════════════════════════
export component GunCon2BindingView inherits DetailPage {
    title: "GunCon 2 Bindings";

    in-out property <bool> trigger-pressed: false;
    in-out property <bool> reload-pressed: false;
