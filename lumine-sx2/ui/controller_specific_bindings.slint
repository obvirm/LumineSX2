                            if red-binding != "" : Text { text: red-binding; color: #ffffff; font-size: 8px; horizontal-alignment: center; overflow: elide; }
                        }
                        TouchArea { clicked => { red-pressed = !red-pressed; bind-button("red"); } }
                    }

                    // Blue
                    Rectangle {
                        width: 80px; height: 80px;
                        background: blue-pressed ? #3b82f6 : (blue-binding != "" ? #93c5fd : #bfdbfe);
                        border-radius: 40px;
                        border-width: 4px;
                        border-color: #2563eb;
                        VerticalLayout {
                            alignment: center; spacing: 4px;
                            Rectangle { width: 40px; height: 12px; background: #2563eb; border-radius: 6px; }
                            Text { text: "BUZZ!"; color: #ffffff; font-size: 11px; font-weight: 700; horizontal-alignment: center; }
                            if blue-binding != "" : Text { text: blue-binding; color: #ffffff; font-size: 8px; horizontal-alignment: center; overflow: elide; }
                        }
                        TouchArea { clicked => { blue-pressed = !blue-pressed; bind-button("blue"); } }
                    }

                    // Yellow
                    Rectangle {
                        width: 80px; height: 80px;
                        background: yellow-pressed ? #eab308 : (yellow-binding != "" ? #fde047 : #fef08a);
                        border-radius: 40px;
                        border-width: 4px;
                        border-color: #ca8a04;
                        VerticalLayout {
                            alignment: center; spacing: 4px;
                            Rectangle { width: 40px; height: 12px; background: #ca8a04; border-radius: 6px; }
                            Text { text: "BUZZ!"; color: #ffffff; font-size: 11px; font-weight: 700; horizontal-alignment: center; }
                            if yellow-binding != "" : Text { text: yellow-binding; color: #ffffff; font-size: 8px; horizontal-alignment: center; overflow: elide; }
                        }
                        TouchArea { clicked => { yellow-pressed = !yellow-pressed; bind-button("yellow"); } }
                    }

                    // Green
                    Rectangle {
                        width: 80px; height: 80px;
                        background: green-pressed ? #22c55e : (green-binding != "" ? #86efac : #bbf7d0);
                        border-radius: 40px;
                        border-width: 4px;
                        border-color: #16a34a;
                        VerticalLayout {
                            alignment: center; spacing: 4px;
                            Rectangle { width: 40px; height: 12px; background: #16a34a; border-radius: 6px; }
                            Text { text: "BUZZ!"; color: #ffffff; font-size: 11px; font-weight: 700; horizontal-alignment: center; }
                            if green-binding != "" : Text { text: green-binding; color: #ffffff; font-size: 8px; horizontal-alignment: center; overflow: elide; }
                        }
                        TouchArea { clicked => { green-pressed = !green-pressed; bind-button("green"); } }
                    }
                }

                HorizontalLayout {
                    spacing: 16px; alignment: center;
                    Text { text: "Red"; color: #ef4444; font-size: 12px; font-weight: 600; width: 80px; horizontal-alignment: center; }
                    Text { text: "Blue"; color: #3b82f6; font-size: 12px; font-weight: 600; width: 80px; horizontal-alignment: center; }
                    Text { text: "Yellow"; color: #eab308; font-size: 12px; font-weight: 600; width: 80px; horizontal-alignment: center; }
                    Text { text: "Green"; color: #22c55e; font-size: 12px; font-weight: 600; width: 80px; horizontal-alignment: center; }
                }
            }
        }

        Rectangle {
            height: 40px;
            background: MaterialColors.surface-container;
            border-radius: 8px;
            HorizontalLayout {
                padding-left: 16px; padding-right: 16px; spacing: 8px;
                Text { text: "🔴 Buzz! — 4 player buzzer bindings"; color: MaterialColors.on-surface-variant; font-size: 12px; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Auto Map"; clicked => { } }
                Button { text: "Clear"; clicked => { red-binding = ""; blue-binding = ""; yellow-binding = ""; green-binding = ""; } }
            }
        }
    }
}

