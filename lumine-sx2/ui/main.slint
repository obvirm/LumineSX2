    in-out property <bool> osd-show-controller-info;
    in-out property <bool> osd-show-turbo-indicator;
    in-out property <bool> osd-show-recording-indicator;
    in-out property <bool> osd-show-log-screen;
    in-out property <bool> osd-show-gs-window-title;
    in-out property <bool> osd-show-notifications;
    in-out property <float> osd-notif-duration;
    in-out property <bool> osd-warn-unsafe;
    in-out property <bool> patch-widescreen;
    in-out property <bool> patch-no-interlace;
    in-out property <bool> patch-no-mpeg;
    in-out property <bool> patch-texture-dump;
    
    in-out property <int> settings-page: 0; // 0=main, 1=Graphics, 2=Audio, 3=Controls, 4=System, 5=MemoryCards, 6=Cheats, 7=Debug
in-out property <int> selected-bios: 0;
    in-out property <string> bios-dir-path: "bios";
    in-out property <bool> fast-boot: true;
    in-out property <bool> fast-forward-boot: false;
    in-out property <[BiosEntry]> bios-entries: [];

    callback browse-bios-folder();
    callback reset-bios-folder();
    callback refresh-bios-list();
    callback select-bios(int);
    callback boot-bios();

    // Memory Card callbacks
    callback memcard-browse-folder();
    callback memcard-open-folder();
    callback memcard-reset-folder();
    callback memcard-refresh-list();
    callback memcard-create(string /*name*/, int /*size*/, bool /*ntfs*/);
    callback memcard-rename(string /*new-name*/);
    callback memcard-delete(int /*index*/);
    callback memcard-convert(int /*index*/, int /*target-type*/);
    callback memcard-select(int /*index*/);
    callback memcard-assign-slot(int /*slot*/, int /*card-index*/);
    callback memcard-eject(int /*slot*/);
    callback memcard-swap-slots();
    callback refresh-hotkeys();
    callback hotkey-capture(string);
    callback hotkey-clear(string);
    callback hotkey-reload();
    callback hotkey-cancel-capture();

    // Memory Card data
    in-out property <string> memcard-folder: "memcards/";
    in-out property <bool> memcard-slot1-enabled: true;
    in-out property <string> memcard-slot1-card: "Mcd001.ps2";
    in-out property <string> memcard-slot1-type: "PS2 (8MB)";
    in-out property <bool> memcard-slot2-enabled: true;
    in-out property <string> memcard-slot2-card: "Mcd002.ps2";
    in-out property <string> memcard-slot2-type: "PS2 (8MB)";
    in-out property <[MemCardInfo]> memcard-list: [];
    in-out property <[HotkeyEntry]> hotkeys: [];
    in-out property <bool> hotkey-capturing: false;
    in-out property <string> hotkey-capturing-name: "";

    property <color> bg: #141218;
    property <color> surface: #1D1B20;
    property <color> surface-variant: #211F26;
    property <color> primary: #D0BCFF;
    property <color> on-primary: #381E72;
    property <color> primary-container: #4A4458;
    property <color> on-primary-container: #E8DEF8;
    property <color> outline: #49454F;
    property <color> text-main: #E6E0E9;
    property <color> text-muted: #938F99;
    property <color> text-variant: #CAC4D0;
    property <color> badge: #332D41;

    min-width: 400px;
    min-height: 700px;
    title: "LumineSX2";
    background: bg;
    default-font-family: "Outfit";

    // Root container - absolute positioning for reliable layout
    Rectangle {
        width: parent.width; height: parent.height;
        background: bg;
        clip: true;

        // Top bar (56px) - only when not playing
        if (!is-playing) : Rectangle {
            x: 0; y: 0; width: parent.width; height: 56px;
            background: bg;
            Rectangle {
                height: 1px; width: parent.width;
                background: surface-variant;
                y: 55px;
            }
            HorizontalLayout {
                width: parent.width; height: parent.height;
                padding-left: 16px; padding-right: 16px;
                alignment: space-between;
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 40px; height: 40px;
                            border-radius: 20px;
                            Image {
                                source: @image-url("logo.png");
                                width: 32px; height: 32px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                    Text { text: "LumineSX2"; color: text-main; font-size: 20px; font-weight: 400; vertical-alignment: center; }
                    
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 32px;
                            border-radius: 16px;
                            border-width: 2.0px;
                            
                            property <float> anim-time: 0.0;
                            
                            Timer {
                                interval: 16ms;
                                running: true;
                                triggered => {
                                    anim-time = anim-time + 0.016 >= 6.0 ? 0.0 : anim-time + 0.016;
                                }
                            }
                            
                            // Cycle value between 0.0 and 6.0 every 6 seconds
                            property <float> cycle-val: mod(anim-time, 6.0);
                            
                            // Blend between Purple (#a855f7) -> Pink (#ec4899) -> Red (#f43f5e) -> Purple
                            property <color> active-color: 
                                cycle-val < 2.0 ? #ec4899.mix(#a855f7, cycle-val / 2.0) :
                                (cycle-val < 4.0 ? #f43f5e.mix(#ec4899, (cycle-val - 2.0) / 2.0) :
                                #a855f7.mix(#f43f5e, (cycle-val - 4.0) / 2.0));

                            border-color: ta-donate.pressed ? active-color.darker(20%) : active-color;
                            background: ta-donate.pressed ? active-color.mix(transparent, 0.25) : ta-donate.has-hover ? active-color.mix(transparent, 0.15) : active-color.mix(transparent, 0.06);
                            
                            // Pulse opacity smoothly between 0.60 and 1.0 over a 2 second period
                            opacity: ta-donate.has-hover ? 1.0 : (0.60 + 0.40 * (sin(360deg * anim-time / 2.0) + 1.0) / 2.0);
                            
                            animate background { duration: 150ms; }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 6px;
                                alignment: center;
                                
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("icons/donation.svg");
                                        colorize: active-color;
                                        width: 16px; height: 16px;
                                    }
                                }
                                Text {
                                    text: "Donate";
                                    color: active-color;
                                    font-size: 13px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                            ta-donate := TouchArea { width: 100%; height: 100%; }
                        }
                    }
                }
                
                HorizontalLayout {
                    alignment: end;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: (current-tab == 0) ? 40px : 0px;
                            height: self.width;
                            border-radius: self.width / 2;
                            opacity: (current-tab == 0) ? 1 : 0;
                            visible: (current-tab == 0) || self.opacity > 0.01;
                            
                            animate width { duration: 200ms; easing: ease-in-out; }
                            animate opacity { duration: 150ms; easing: ease-in-out; }
                            
                            Image { 
                                source: game-list-view == 0 ? @image-url("icons/qt/file-list-line.svg") : @image-url("icons/qt/dashboard-line.svg"); 
                                colorize: text-variant; 
                                width: parent.width > 20px ? 20px : parent.width; 
                                height: self.width; 
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                            TouchArea { width: 100%; height: 100%; enabled: current-tab == 0; clicked => { game-list-view = game-list-view == 0 ? 1 : 0; } }
                        }
                    }
                }
            }
        }

        if (is-playing) : Rectangle {
            x: 0; y: 0; width: parent.width; height: parent.height;
            background: black;
            if (framebuffer.width > 0) : Image {
                source: framebuffer;
                width: parent.width;
                height: parent.height;
            }
            
            Rectangle {
                y: 0px; height: 64px; width: parent.width;
                HorizontalLayout {
                    width: parent.width; height: parent.height;
                    padding: 16px;
                    alignment: space-between;
                    Rectangle {
                        width: 40px; height: 40px; border-radius: 20px; background: #00000099; border-width: 1px; border-color: #ffffff1a;
                        Image {
                            source: @image-url("icons/qt/arrow-left-right-line.svg");
                            colorize: white;
                            width: 24px; height: 24px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                        TouchArea { width: 100%; height: 100%; clicked => { root.stop-game(); } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            width: 40px; height: 40px; border-radius: 20px; background: #00000099; border-width: 1px; border-color: #ffffff1a;
                            Image {
                                source: @image-url("icons/qt/settings-3-line.svg");
                                colorize: white;
                                width: 20px; height: 20px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                            TouchArea { width: 100%; height: 100%; clicked => { show-quick-menu = !show-quick-menu; } }
                        }
                    }
                }
            }

            Rectangle {
                x: (parent.width - self.width) / 2; y: 16px;
                width: 180px; height: 28px;
                border-radius: 14px; background: #00000099; border-width: 1px; border-color: #ffffff1a;
                Text { text: "FPS: " + emu-state.fps + " | Spd: " + emu-state.speed + "%"; color: #ffffffcc; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; font-family: "monospace"; }
            }

            if (show-quick-menu) : Rectangle {
                x: parent.width - 240px - 16px;
                y: 70px;
                width: 240px; height: 200px;
                background: #1c1b22; border-radius: 16px; border-width: 1px; border-color: #ffffff1a;
                VerticalLayout {
                    padding: 16px; spacing: 12px;
                    Text { text: "QUICK CONTROL PANEL"; color: white; font-size: 12px; font-weight: 600; }
                    Text { text: "EE Cycle Rate (Speed): " + emu-state.speed + "%"; color: #ffffff99; font-size: 11px; }
                    Rectangle { height: 4px; background: #ffffff1a; border-radius: 2px;
                        Rectangle { width: 50%; height: parent.height; background: primary; border-radius: 2px; }
                    }
                    Rectangle { height: 1px; background: #ffffff1a; }
                    Rectangle {
                        height: 36px; border-radius: 8px; background: #36343b;
                        Text { text: "Instant Savestate"; color: white; font-size: 13px; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { width: 100%; height: 100%; clicked => { show-quick-menu = false; } }
                    }
                }
            }

            // Touch Controller Overlay
            Rectangle {
                width: parent.width;
                height: parent.height;
                background: transparent;
                
                // Shoulder Buttons
                // L1/L2 on the top left
                HorizontalLayout {
                    x: 16px;
                    y: 72px;
                    width: 116px;
                    spacing: 8px;
                    ShoulderButton { text: "L2"; }
                    ShoulderButton { text: "L1"; }
                }
                
                // R1/R2 on the top right
                HorizontalLayout {
                    x: parent.width - self.width - 16px;
                    y: 72px;
                    width: 116px;
                    spacing: 8px;
                    ShoulderButton { text: "R1"; }
                    ShoulderButton { text: "R2"; }
                }
                
                // Left controls: D-Pad and Left Analog Stick
                VerticalLayout {
                    x: 24px;
                    y: parent.height - self.height - 24px;
                    width: 120px;
                    spacing: 24px;
                    
                    DPad {}
                    
                    Rectangle {
                        width: 120px;
                        height: 110px;
                        AnalogStick {
                            x: (parent.width - self.width)/2;
                            y: (parent.height - self.height)/2;
                        }
                    }
                }
                
                // Right controls: Action Buttons and Right Analog Stick
                VerticalLayout {
                    x: parent.width - self.width - 24px;
                    y: parent.height - self.height - 24px;
                    width: 130px;
                    spacing: 24px;
                    
                    ActionGroup {}
                    
                    Rectangle {
                        width: 130px;
                        height: 110px;
                        AnalogStick {
                            x: (parent.width - self.width)/2;
                            y: (parent.height - self.height)/2;
                        }
                    }
                }
                
                // Select & Start in the center bottom
                HorizontalLayout {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height - 24px;
                    width: 144px;
                    spacing: 16px;
                    CenterButton { text: "SELECT"; }
                    CenterButton { text: "START"; }
                }
            }
        }

        // ═══════════════════════════════════════
        //  MAIN CONTENT AREA — Games / States / Settings
        //  Horizontal slide animation (desain asli)
        // ═══════════════════════════════════════

        // ── Games Tab ──
        games-tab := VerticalLayout {
            y: 56px; height: parent.height - 56px; width: parent.width;
            x: (!is-playing && settings-page == 0 && current-tab == 0) ? 0px : -parent.width;
            opacity: (!is-playing && settings-page == 0 && current-tab == 0) ? 1.0 : 0.0;
            animate x { duration: 300ms; easing: ease-in-out; }
            animate opacity { duration: 300ms; easing: ease-in-out; }
            padding-left: 16px; padding-right: 16px;
            padding-top: 8px; padding-bottom: 96px;
            spacing: 12px;
            alignment: start;

            Rectangle {
                height: 44px;
                border-radius: 22px;
                background: surface-variant;
                border-width: 1px;
                border-color: #49454F4d;
                HorizontalLayout {
                    width: parent.width; height: parent.height;
                    padding-left: 16px; spacing: 12px; alignment: start;
                    VerticalLayout { alignment: center; Image { source: @image-url("icons/qt/search-line.svg"); colorize: text-variant; width: 16px; height: 16px; } }
                    Text { text: "Search ISO games..."; color: text-muted; font-size: 14px; vertical-alignment: center; }
                }
            }

            HorizontalLayout {
                height: 32px; spacing: 8px; alignment: start;
                for region in ["All", "NTSC-U", "PAL", "NTSC-J"] : Rectangle {
                    border-radius: 16px;
                    background: region-filter == region ? primary : surface-variant;
                    border-width: 1px;
                    border-color: region-filter == region ? transparent : #49454F66;
                    animate background { duration: 200ms; easing: ease-in-out; }
                    animate border-color { duration: 200ms; easing: ease-in-out; }
                    width: 80px;
                    Text {
                        text: region == "All" ? "All Region" : region;
                        color: region-filter == region ? on-primary : text-variant;
                        animate color { duration: 200ms; easing: ease-in-out; }
                        font-size: 12px; font-weight: 500;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea { width: 100%; height: 100%; clicked => { region-filter = region; } }
                }
            }

            game-list-container := Rectangle {
                property <int> cols:
                    self.width < 320px ? 1 :
                    self.width < 480px ? 2 :
                    self.width < 640px ? 3 :
                    self.width < 800px ? 4 :
                    self.width < 960px ? 5 :
                    self.width < 1120px ? 6 :
                    self.width < 1280px ? 7 :
                    self.width < 1440px ? 8 : 9;
                property <length> item-width: (self.width - (cols - 1) * 16px) / cols;

                height: game-list.length == 0 ? 0px : (game-list-view == 0 ? Math.ceil(game-list.length / cols) * 216px : game-list.length * 108px);
                animate height { duration: 350ms; easing: ease-in-out; }

                for game[idx] in game-list : Rectangle {
                    x: game-list-view == 0 ? Math.mod(idx, cols) * (item-width + 16px) : 0px;
                    y: game-list-view == 0 ? Math.floor(idx / cols) * 216px : idx * 108px;
                    width: game-list-view == 0 ? item-width : parent.width;
                    height: game-list-view == 0 ? 200px : 96px;
                    border-radius: 16px;
                    background: ta-card.has-hover ? surface-variant : surface;
                    border-width: 1px;
                    border-color: ta-card.has-hover ? #ffffff1c : transparent;

                    animate x { duration: 350ms; easing: ease-in-out; }
                    animate y { duration: 350ms; easing: ease-in-out; }
                    animate width { duration: 350ms; easing: ease-in-out; }
                    animate height { duration: 350ms; easing: ease-in-out; }
                    animate background { duration: 150ms; }
                    animate border-color { duration: 150ms; }

                    cover := Rectangle {
                        clip: true;
                        x: game-list-view == 0 ? 0px : 12px;
                        y: game-list-view == 0 ? 0px : 12px;
                        width: game-list-view == 0 ? parent.width : 64px;
                        height: game-list-view == 0 ? 140px : 80px;
                        border-top-left-radius: game-list-view == 0 ? 16px : 12px;
                        border-top-right-radius: game-list-view == 0 ? 16px : 12px;
                        border-bottom-left-radius: game-list-view == 0 ? 0px : 12px;
                        border-bottom-right-radius: game-list-view == 0 ? 0px : 12px;
                        background: game.color;

                        animate x { duration: 350ms; easing: ease-in-out; }
                        animate y { duration: 350ms; easing: ease-in-out; }
                        animate width { duration: 350ms; easing: ease-in-out; }
                        animate height { duration: 350ms; easing: ease-in-out; }
                        animate border-top-left-radius { duration: 350ms; }
                        animate border-top-right-radius { duration: 350ms; }
                        animate border-bottom-left-radius { duration: 350ms; }
                        animate border-bottom-right-radius { duration: 350ms; }

                        if (game.cover.width > 0) : Image {
                            source: game.cover;
                            width: 100%; height: 100%;
                            image-fit: ImageFit.cover;
                        }

                        if (game.cover.width == 0) : Image {
                            source: @image-url("icons/qt/gamepad-2.svg");
                            colorize: #ffffff4d;
                            width: game-list-view == 0 ? 48px : 28px;
                            height: self.width;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            animate width { duration: 350ms; easing: ease-in-out; }
                        }
                    }

                    Rectangle {
                        x: game-list-view == 0 ? 12px : 88px;
                        y: game-list-view == 0 ? 152px : 12px;
                        width: game-list-view == 0 ? parent.width - 24px : parent.width - 100px;
                        height: game-list-view == 0 ? 44px : parent.height;
                        clip: true;

                        animate x { duration: 350ms; easing: ease-in-out; }
                        animate y { duration: 350ms; easing: ease-in-out; }
                        animate width { duration: 350ms; easing: ease-in-out; }

                    VerticalLayout {
                        spacing: 0px;
                        alignment: start;

                        Text { text: game.title; color: text-main; font-size: game-list-view == 0 ? 13px : 15px; font-weight: 500; overflow: elide; animate font-size { duration: 350ms; easing: ease-in-out; } }
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            Rectangle {
                                width: badge-text.width + 12px;
                                height: game-list-view == 0 ? 18px : 20px;
                                border-radius: 4px;
                                background: badge;
                                badge-text := Text { text: game.region; color: on-primary-container; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Text { text: game.size; color: text-variant; font-size: 10px; vertical-alignment: center; }
                        }
                    }
                    }  // clip Rectangle

                    Rectangle {
                        x: parent.width - 32px; y: game-list-view == 0 ? 8px : 12px;
                        width: 24px; height: 24px; border-radius: 12px;
                        background: game.favorite ? #facc15 : #00000066;
                        border-width: 1px; border-color: game.favorite ? #facc15 : outline;

                        animate y { duration: 350ms; easing: ease-in-out; }
                        animate background { duration: 350ms; }
                        animate border-color { duration: 350ms; }

                        if (game.favorite) : Text { text: "★"; color: #000000; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }

                    ta-card := TouchArea { width: 100%; height: 100%; clicked => { root.selected-game = idx; root.play-game(); } }
                }
            }

            if (game-list.length == 0) : VerticalLayout {
                spacing: 16px;
                padding-top: 32px;
                width: parent.width;
                alignment: center;

                Rectangle {
                    width: 80px; height: 80px; border-radius: 40px; background: #2B2930;
                    Image { source: @image-url("icons/qt/disc-2-line.svg"); colorize: #938F99; width: 40px; height: 40px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                }
                Text { text: "Belum Ada Game"; color: #E6E0E9; font-size: 18px; font-weight: 600; horizontal-alignment: center; }
                Text { text: "Tambahkan direktori game PS2 kamu untuk memulai"; color: #938F99; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; }
                Rectangle {
                    height: 40px; border-radius: 20px; background: #D0BCFF; width: 200px;
                    Text { text: "+ Tambah Direktori"; color: #381E72; font-size: 14px; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { settings-page = 0; current-tab = 2; } }
                }
            }
        }
        // ── States Tab ──
        states-tab := VerticalLayout {
            y: 56px; height: parent.height - 56px; width: parent.width;
            x: (!is-playing && settings-page == 0 && current-tab == 1) ? 0px : (current-tab < 1 ? parent.width : -parent.width);
            opacity: (!is-playing && settings-page == 0 && current-tab == 1) ? 1.0 : 0.0;
            animate x { duration: 300ms; easing: ease-in-out; }
            animate opacity { duration: 300ms; easing: ease-in-out; }
            padding-left: 16px; padding-right: 16px;
            padding-top: 16px; padding-bottom: 96px;
            spacing: 16px;
            alignment: start;

            HorizontalLayout {
                alignment: space-between;
                Text { text: "STORED SAVE STATES"; color: primary; font-size: 12px; font-weight: 600; letter-spacing: 1px; }
                Text { text: save-states.length + " Slots Busy"; color: text-muted; font-size: 12px; font-family: "monospace"; }
            }

            if (save-states.length == 0) : Rectangle {
                height: 160px; border-radius: 24px; background: surface; border-width: 1px; border-color: #49454F33;
                VerticalLayout {
                    alignment: center; spacing: 8px;
                    Image { source: @image-url("icons/qt/save-3-line.svg"); colorize: text-variant; width: 36px; height: 36px; horizontal-alignment: center; }
                    Text { text: "No active save states found."; color: text-variant; font-size: 14px; horizontal-alignment: center; }
                    Text { text: "States can be created during live emulations."; color: text-muted; font-size: 12px; horizontal-alignment: center; }
                }
            }

            for state in save-states : Rectangle {
                height: 88px; border-radius: 16px; background: surface; border-width: 1px; border-color: #49454F4d;
                HorizontalLayout {
                    width: parent.width; height: parent.height; padding: 16px; alignment: space-between;
                    VerticalLayout {
                        spacing: 4px; alignment: center;
                        Text { text: state.game_title; color: text-main; font-size: 14px; font-weight: 600; }
                        Text { text: state.timestamp; color: text-muted; font-size: 12px; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text { text: state.progress; color: primary; font-size: 12px; font-weight: 500; }
                    }
                }
            }
        }
        // ── Settings Tab ──
        settings-tab := Rectangle {
            y: 56px; height: parent.height - 56px; width: parent.width;
            x: (!is-playing && settings-page == 0 && current-tab == 2) ? 0px : (settings-page > 0 ? -parent.width : parent.width);
            opacity: 1.0;
            clip: true;
            animate x { duration: 300ms; easing: ease-in-out; }

            ScrollView {
                VerticalLayout {
                    padding-bottom: 96px;
                    spacing: 16px;
                    padding-top: 8px;

                    // BIOS summary + open folder
                    SettingsRow {
                        txt: "Folder BIOS PS2";
                        sub: bios-dir-path != "bios" ? bios-dir-path : bios-list.length + " BIOS found • Klik untuk pilih folder";
                        ico: @image-url("icons/qt/folder-open-line.svg");
                        clicked => { root.open-bios-folder(); }
                    }

                    // Quick actions
                    VerticalLayout {
                        padding-left: 16px; padding-right: 16px; spacing: 8px;
                        SettingsRow { txt: "Mulai File"; ico: @image-url("icons/qt/disc-2-line.svg"); }
                        SettingsRow { txt: "Mulai BIOS"; ico: @image-url("icons/qt/shut-down-line.svg"); clicked => { root.boot-bios(); } }
                    }

                    VerticalLayout {
                        padding-left: 16px; padding-right: 16px; padding-top: 8px; spacing: 8px;
                        HorizontalLayout { padding-left: 68px; padding-bottom: 4px; Text { text: "Pengaturan Sistem"; color: primary; font-size: 13px; font-weight: 600; letter-spacing: 0.5px; } }
                        SettingsRow { txt: "Pengaturan Aplikasi"; sub: "Theme, language, confirm on exit"; ico: @image-url("icons/qt/settings-3-line.svg"); clicked => { settings-page = 1; } }
                        SettingsRow { txt: "Pengaturan Emulasi"; sub: "Speed, frame pacing, VSync, timing"; ico: @image-url("icons/qt/chip-line.svg"); clicked => { settings-page = 4; } }
                        SettingsRow { txt: "Pengaturan Grafis"; sub: "Renderer, resolution, filtering, post-processing"; ico: @image-url("icons/qt/image-fill.svg"); clicked => { settings-page = 3; } }
                        SettingsRow { txt: "Pengaturan Audio"; sub: "Backend, volume, latency"; ico: @image-url("icons/qt/settings-3-line.svg"); clicked => { settings-page = 6; } }
                        SettingsRow { txt: "Pengaturan Pengontrol"; sub: "Virtual Touch mapping, input bind, getaran"; ico: @image-url("icons/qt/controller-line.svg"); clicked => { settings-page = 2; } }
                        SettingsRow { txt: "Pengaturan BIOS"; sub: "BIOS directory, fast boot"; ico: @image-url("icons/qt/chip-line.svg"); clicked => { settings-page = 5; root.refresh-bios-list(); } }
                        SettingsRow { txt: "Kartu Memori"; sub: "Port 1/2, card type, size"; ico: @image-url("icons/qt/save-3-line.svg"); clicked => { settings-page = 8; } }
                        SettingsRow { txt: "On-Screen Display"; sub: "Performance overlay, notifications"; ico: @image-url("icons/qt/settings-3-line.svg"); clicked => { settings-page = 7; } }
                        SettingsRow { txt: "Achievements"; sub: "RetroAchievements login, tracking"; ico: @image-url("icons/qt/lightbulb-line.svg"); clicked => { settings-page = 9; } }
                    }

                    VerticalLayout {
                        padding-left: 16px; padding-right: 16px; padding-top: 8px; spacing: 8px;
                        HorizontalLayout { padding-left: 68px; padding-bottom: 4px; Text { text: "Advanced"; color: primary; font-size: 13px; font-weight: 600; letter-spacing: 0.5px; } }
                        SettingsRow { txt: "Lanjutan"; sub: "EE/VU clamp, savestate compression"; ico: @image-url("icons/qt/settings-3-line.svg"); clicked => { settings-page = 14; } }
                        SettingsRow { txt: "Folder"; sub: "Custom paths for saves, snapshots, logs"; ico: @image-url("icons/qt/folder-open-line.svg"); clicked => { settings-page = 13; } }
                    }

                    VerticalLayout {
                        padding-left: 16px; padding-right: 16px; padding-top: 8px; spacing: 8px;
                        HorizontalLayout { padding-left: 68px; padding-bottom: 4px; Text { text: "Manajemen Data & Sampul"; color: primary; font-size: 13px; font-weight: 600; letter-spacing: 0.5px; } }
                        SettingsRow { txt: "Pindai Permainan Baru"; ico: @image-url("icons/qt/refresh-line.svg"); }
                        SettingsRow { txt: "Pindai Ulang Semua Permainan"; ico: @image-url("icons/qt/refresh-line.svg"); }
