import { Button, HorizontalBox, VerticalBox, LineEdit, ComboBox, CheckBox } from "std-widgets.slint";

// ─── Breakpoint Dialog ───
export struct BreakpointDialogData {
    address: string,
    type: int,  // 0=Execute, 1=Read, 2=Write, 3=Read/Write
    size: int,
    condition: string,
    enabled: bool,
    label: string,
}

export component BreakpointDialog inherits Rectangle {
    in property <bool> is-edit-mode: false;
    in property <BreakpointDialogData> data: {
        address: "0x00000000",
        type: 0,
        size: 4,
        condition: "",
        enabled: true,
        label: "",
    };

    callback confirmed(BreakpointDialogData /*data*/);
    callback cancelled();

    background: #11111b;

    Rectangle {
        width: 400px;
        height: 300px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: #1e1e2e;
        border-radius: 8px;
        border-width: 1px;
        border-color: #313244;

        VerticalBox {
            padding: 16px;
            spacing: 12px;

            // Title
            Text {
                text: root.is-edit-mode ? "Edit Breakpoint" : "Add Breakpoint";
                color: #cdd6f4;
                font-size: 14px;
                font-weight: 700;
            }

            // Address
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Address:";
                    color: #cdd6f4;
                    font-size: 11px;
                    vertical-alignment: center;
                    width: 80px;
                }
                LineEdit {
                    text: root.data.address;
                    font-size: 11px;
                    horizontal-stretch: 1;
                }
            }

            // Type
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Type:";
                    color: #cdd6f4;
                    font-size: 11px;
                    vertical-alignment: center;
                    width: 80px;
                }
                ComboBox {
                    model: ["Execute", "Read", "Write", "Read/Write"];
                    current-index: root.data.type;
                }
            }

            // Size (for data breakpoints)
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Size:";
                    color: #cdd6f4;
                    font-size: 11px;
                    vertical-alignment: center;
                    width: 80px;
                }
                ComboBox {
                    model: ["1 byte", "2 bytes", "4 bytes", "8 bytes", "16 bytes"];
                    current-index: 2;
                }
            }

            // Condition
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Condition:";
                    color: #cdd6f4;
                    font-size: 11px;
                    vertical-alignment: center;
                    width: 80px;
                }
                LineEdit {
                    text: root.data.condition;
                    placeholder-text: "Optional condition...";
                    font-size: 11px;
                    horizontal-stretch: 1;
                }
            }

            // Enabled checkbox
            HorizontalLayout {
                spacing: 8px;
                Rectangle { width: 80px; }
                CheckBox {
                    checked: root.data.enabled;
                    text: "Enabled";
                }
            }

            // Buttons
            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: "Cancel";
                    clicked => { root.cancelled(); }
                    min-width: 80px;
                }
                Button {
                    text: root.is-edit-mode ? "Save" : "Add";
                    clicked => { root.confirmed(root.data); }
                    min-width: 80px;
                }
            }
        }
    }
}
