export struct EmuState {
    frame: int,
    ee_pc: int,
    iop_pc: int,
    fps: int,
    speed: int,
}

export struct GameInfo {
    title: string,
    path: string,
    region: string,
    code: string,
    size: string,
    color: color,
    favorite: bool,
    cover: image,
}

export struct SaveState {
    game_title: string,
    timestamp: string,
    progress: string,
}

export struct BiosInfo {
    name: string,
    status: string,
    selected: bool,
}

component SettingsRow inherits Rectangle {
    in property <string> txt;
    in property <string> sub: "";
    in property <image> ico;
    
    callback clicked;
    
    height: sub != "" ? 64px : 48px;
    background: ta.pressed ? #ffffff11 : ta.has-hover ? #ffffff05 : transparent;
    animate background { duration: 150ms; }

    HorizontalLayout {
        spacing: 16px;
        padding-left: 20px;
        padding-right: 20px;
        
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            Rectangle { 
                width: 32px; 
                height: 32px; 
                background: transparent;
                Image {
                    source: ico;
                    colorize: #D0BCFF;
                    width: 20px; height: 20px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
        VerticalLayout { 
            horizontal-stretch: 1;
            spacing: sub != "" ? 4px : 0px; 
            alignment: center;
            Text { text: txt; color: #E6E0E9; font-size: 15px; font-weight: 500; overflow: elide; }
            if (sub != "") : Text { text: sub; color: #938F99; font-size: 12px; overflow: elide; }
        }
    }
    Rectangle { height: 1px; background: #211F26; y: parent.height - 1px; x: 68px; width: parent.width - 88px; }
    
    ta := TouchArea { clicked => { root.clicked(); } }
}

component DPadButton inherits Rectangle {
    in property <string> text;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: ta.pressed ? #ffffff50 : #ffffff15;
    border-width: 1.5px;
    border-color: #ffffff30;
    
    animate background { duration: 100ms; }
    
    Text {
        text: text;
        color: #ffffffd0;
        font-size: 16px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    
    ta := TouchArea {}
}

component DPad inherits Rectangle {
    width: 120px;
    height: 120px;
    background: #ffffff05;
    border-radius: 60px;
    border-width: 1.2px;
    border-color: #ffffff10;
    
    DPadButton { text: "▲"; x: 42px; y: 4px; }
    DPadButton { text: "▼"; x: 42px; y: 80px; }
    DPadButton { text: "◀"; x: 4px; y: 42px; }
    DPadButton { text: "▶"; x: 80px; y: 42px; }
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <color> label-color: #ffffff;
    width: 38px;
    height: 38px;
    border-radius: 19px;
    background: ta.pressed ? #ffffff50 : #ffffff15;
    border-width: 1.5px;
    border-color: #ffffff30;
    
    animate background { duration: 100ms; }
    
    Text {
        text: label;
        color: label-color;
        font-size: 16px;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    
    ta := TouchArea {}
}

component ActionGroup inherits Rectangle {
    width: 130px;
    height: 130px;
    background: #ffffff05;
    border-radius: 65px;
    border-width: 1.2px;
    border-color: #ffffff10;
    
    ActionButton { label: "▲"; label-color: #4ade80; x: 46px; y: 4px; } // Triangle (Green)
    ActionButton { label: "✕"; label-color: #60a5fa; x: 46px; y: 88px; } // Cross (Blue)
    ActionButton { label: "■"; label-color: #f472b6; x: 4px; y: 46px; }  // Square (Pink)
    ActionButton { label: "●"; label-color: #f87171; x: 88px; y: 46px; }  // Circle (Red)
}

component ShoulderButton inherits Rectangle {
    in property <string> text;
    width: 54px;
    height: 32px;
    border-radius: 6px;
    background: ta.pressed ? #ffffff50 : #ffffff12;
    border-width: 1px;
    border-color: #ffffff20;
    
    animate background { duration: 100ms; }
    
    Text {
        text: text;
        color: #ffffffcc;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {}
}

component CenterButton inherits Rectangle {
    in property <string> text;
    width: 64px;
    height: 24px;
    border-radius: 4px;
    background: ta.pressed ? #ffffff40 : #ffffff12;
    border-width: 1px;
    border-color: #ffffff18;
    
    animate background { duration: 100ms; }
    
    Text {
        text: text;
        color: #ffffffa0;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {}
}

component AnalogStick inherits Rectangle {
    width: 110px;
    height: 110px;
    border-radius: 55px;
    background: #ffffff0a;
    border-width: 1.5px;
    border-color: #ffffff15;
    
    property <length> stick-x: ta.pressed ? Math.clamp(ta.mouse-x - 55px, -30px, 30px) : 0px;
    property <length> stick-y: ta.pressed ? Math.clamp(ta.mouse-y - 55px, -30px, 30px) : 0px;
    
    animate stick-x { duration: 80ms; easing: ease-out; }
    animate stick-y { duration: 80ms; easing: ease-out; }
    
    knob := Rectangle {
        width: 48px;
        height: 48px;
        border-radius: 24px;
        background: ta.pressed ? #ffffff55 : #ffffff25;
        border-width: 1px;
        border-color: #ffffff60;
        
        x: (parent.width - self.width)/2 + stick-x;
        y: (parent.height - self.height)/2 + stick-y;
        
        animate background { duration: 100ms; }
    }
    
    ta := TouchArea {
        width: 100%;
        height: 100%;
    }
}

