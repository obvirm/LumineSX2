// Log Viewer — parity with Qt LogViewer.cpp (11 channels -> single stream)
import { ScrollView } from "std-widgets.slint";

export component LogViewerView inherits Rectangle {
    callback back-clicked;
    callback clear-log();

    in-out property <[string]> log-lines: [];

    background: #141218;
    clip: true;

    VerticalLayout {
        y: 56px;
        width: parent.width;
        height: parent.height - 56px;
        spacing: 0px;

        Rectangle {
            height: 56px;
            background: #141218;
            HorizontalLayout {
                spacing: 8px;
                padding-left: 8px;
                padding-right: 16px;
                alignment: start;
                Rectangle {
                    width: 40px; height: 40px;
                    border-radius: 20px;
                    TouchArea {
                        clicked => { root.back-clicked(); }
                        Rectangle {
                            width: 40px; height: 40px;
                            border-radius: 20px;
                            Image { source: @image-url("icons/qt/arrow-left-line.svg"); colorize: #E6E0E9; width: 22px; height: 22px; x: 9px; y: 9px; }
                        }
                    }
                }
                Text { text: "Log Emulator"; color: #E6E0E9; font-size: 18px; font-weight: 600; vertical-alignment: center; }
                Rectangle { width: 8px; }
                TouchArea {
                    clicked => { root.clear-log(); }
                    Rectangle {
                        height: 36px; min-width: 90px; border-radius: 18px; background: #1D1B20;
                        Text { text: "Bersihkan"; color: #E6E0E9; font-size: 13px; vertical-alignment: center; horizontal-alignment: center; }
                    }
                }
            }
        }

        Rectangle {
            background: #0E0C12;
            clip: true;
            ScrollView {
                viewport-width: parent.width;
                VerticalLayout {
                    spacing: 2px;
                    padding: 10px;
                    alignment: start;
                    for line in root.log-lines : Text {
                        text: line;
                        color: #C8C3CE;
                        font-size: 12px;
                        font-family: "monospace";
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
