    in-out property <bool> dpad-up: false;
    in-out property <bool> dpad-down: false;
    in-out property <bool> dpad-left: false;
    in-out property <bool> dpad-right: false;
    in-out property <bool> button-a: false;
    in-out property <bool> button-b: false;

    in-out property <string> trigger-binding: "";
    in-out property <string> reload-binding: "";
    in-out property <string> aim-binding: "";
    in-out property <string> select-binding: "";
    in-out property <string> start-binding: "";
    in-out property <string> dpad-up-binding: "";
    in-out property <string> dpad-down-binding: "";
    in-out property <string> dpad-left-binding: "";
    in-out property <string> dpad-right-binding: "";
    in-out property <string> button-a-binding: "";
    in-out property <string> button-b-binding: "";

    callback bind-button(string);
    callback reset-binding(string);

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        Rectangle {
            height: 280px;
            background: MaterialColors.surface-container;
            border-radius: 16px;
            border-width: 1px;
            border-color: MaterialColors.outline;

            HorizontalLayout {
                padding: 16px;
                spacing: 16px;

                // Left: Gun body
                Rectangle {
                    width: 100px;
                    height: 200px;
                    background: MaterialColors.surface-container-high;
                    border-radius: 12px;
                    border-width: 2px;
                    border-color: MaterialColors.outline;

                    y: 40px;

                    VerticalLayout {
                        spacing: 8px;
                        alignment: center;

                        Rectangle { width: 20px; height: 50px; background: MaterialColors.surface-container-high; border-radius: 10px; border-width: 1px; border-color: MaterialColors.outline; }

                        Rectangle {
                            width: 36px; height: 36px;
                            background: trigger-pressed ? #ef4444 : (trigger-binding != "" ? MaterialColors.error-container : MaterialColors.surface);
                            border-radius: 18px;
                            border-width: 2px;
                            border-color: trigger-binding != "" ? MaterialColors.error : MaterialColors.outline;
                            Text { text: "🔫"; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { trigger-pressed = !trigger-pressed; bind-button("trigger"); } }
                        }
                        if trigger-binding != "" : Text { text: trigger-binding; color: MaterialColors.on-surface-variant; font-size: 9px; horizontal-alignment: center; }

                        Rectangle {
                            width: 40px; height: 24px;
                            background: reload-pressed ? MaterialColors.primary-container : (reload-binding != "" ? MaterialColors.tertiary-container : MaterialColors.surface);
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: reload-binding != "" ? MaterialColors.tertiary : MaterialColors.outline;
                            Text { text: "Reload"; color: reload-pressed ? MaterialColors.on-primary-container : (reload-binding != "" ? MaterialColors.on-tertiary-container : MaterialColors.on-surface); font-size: 9px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { reload-pressed = !reload-pressed; bind-button("reload"); } }
                        }

                        BindingButton { txt: "Aim Off-Screen"; button-font-size: 10; binding: aim-binding; is-bound: aim-binding != ""; pressed: aim-off-screen; idle-color: MaterialColors.surface; clicked => { aim-off-screen = !aim-off-screen; bind-button("aim"); } }
                    }
                }

                // Right: D-Pad + Select/Start + A/B
                VerticalLayout {
                    spacing: 12px;
                    width: 160px;
                    alignment: center;

                    Text { text: "GunCon 2"; color: MaterialColors.primary; font-size: 16px; font-weight: 600; horizontal-alignment: center; }
                    Text { text: "Light Gun Controller"; color: MaterialColors.on-surface-variant; font-size: 11px; horizontal-alignment: center; }

                    Text { text: "D-Pad"; color: MaterialColors.primary; font-size: 12px; font-weight: 600; }

                    GridLayout {
                        spacing: 3px;
                        Rectangle { col: 0; row: 0; width: 44px; height: 44px; }
                        BindingButton { col: 1; row: 0; txt: "▲"; button-font-size: 16; binding: dpad-up-binding; is-bound: dpad-up-binding != ""; pressed: dpad-up; clicked => { dpad-up = !dpad-up; bind-button("up"); } }
                        Rectangle { col: 2; row: 0; width: 44px; height: 44px; }
                        BindingButton { col: 0; row: 1; txt: "◄"; button-font-size: 16; binding: dpad-left-binding; is-bound: dpad-left-binding != ""; pressed: dpad-left; clicked => { dpad-left = !dpad-left; bind-button("left"); } }
                        Rectangle { col: 1; row: 1; width: 44px; height: 44px; background: MaterialColors.surface-container-high; border-radius: 6px; }
                        BindingButton { col: 2; row: 1; txt: "►"; button-font-size: 16; binding: dpad-right-binding; is-bound: dpad-right-binding != ""; pressed: dpad-right; clicked => { dpad-right = !dpad-right; bind-button("right"); } }
                        Rectangle { col: 0; row: 2; width: 44px; height: 44px; }
                        BindingButton { col: 1; row: 2; txt: "▼"; button-font-size: 16; binding: dpad-down-binding; is-bound: dpad-down-binding != ""; pressed: dpad-down; clicked => { dpad-down = !dpad-down; bind-button("down"); } }
                        Rectangle { col: 2; row: 2; width: 44px; height: 44px; }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        BindingButton { txt: "Select"; button-font-size: 11; binding: select-binding; is-bound: select-binding != ""; pressed: select-pressed; clicked => { select-pressed = !select-pressed; bind-button("select"); } }
                        BindingButton { txt: "Start"; button-font-size: 11; binding: start-binding; is-bound: start-binding != ""; pressed: start-pressed; clicked => { start-pressed = !start-pressed; bind-button("start"); } }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        BindingButton { txt: "A"; button-font-size: 14; binding: button-a-binding; is-bound: button-a-binding != ""; pressed: button-a; clicked => { button-a = !button-a; bind-button("a"); } }
                        BindingButton { txt: "B"; button-font-size: 14; binding: button-b-binding; is-bound: button-b-binding != ""; pressed: button-b; clicked => { button-b = !button-b; bind-button("b"); } }
                    }
                }
            }
        }

        Rectangle {
            height: 40px;
            background: MaterialColors.surface-container;
            border-radius: 8px;
            HorizontalLayout {
                padding-left: 16px; padding-right: 16px; spacing: 8px;
                Text { text: "🔫 GunCon 2 — Light Gun (11 bindings)"; color: MaterialColors.on-surface-variant; font-size: 12px; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Auto Map"; clicked => { } }
                Button {
                    text: "Clear";
                    clicked => {
                        trigger-binding = ""; reload-binding = ""; aim-binding = "";
                        select-binding = ""; start-binding = "";
                        dpad-up-binding = ""; dpad-down-binding = ""; dpad-left-binding = ""; dpad-right-binding = "";
                        button-a-binding = ""; button-b-binding = "";
                    }
                }
            }
        }
    }
}
