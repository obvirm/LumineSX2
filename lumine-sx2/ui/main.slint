                wait-loop <=> root.adv-wait-loop;
                fast-mem <=> root.adv-fast-mem;
                pause-on-tlb <=> root.adv-pause-on-tlb;
                extended-ram <=> root.adv-extended-ram;
                vu0-clamp <=> root.adv-vu0-clamp;
                vu0-round <=> root.adv-vu0-round;
                vu1-clamp <=> root.adv-vu1-clamp;
                vu1-round <=> root.adv-vu1-round;
                vu0-recompiler <=> root.adv-vu0-recompiler;
                vu1-recompiler <=> root.adv-vu1-recompiler;
                mvu-flag <=> root.adv-mvu-flag;
                instant-vu1 <=> root.adv-instant-vu1;
                iop-recompiler <=> root.adv-iop-recompiler;
                compression-method <=> root.adv-compression-method;
                compression-level <=> root.adv-compression-level;
                backup-savestates <=> root.adv-backup-savestates;
                host-fs <=> root.adv-host-fs;
                pine-enabled <=> root.adv-pine-enabled;
                pine-slot <=> root.adv-pine-slot;
}
        }
        Rectangle {
            x: settings-page == 15 ? 0px : parent.width;
            animate x { duration: 300ms; easing: ease-in-out; }
            y: 56px; height: parent.height - 56px; width: parent.width;
            ExperimentalWarningView { back-clicked => { settings-page = 0; } }
        }
        Rectangle {
            x: settings-page == 16 ? 0px : parent.width;
            animate x { duration: 300ms; easing: ease-in-out; }
            y: 56px; height: parent.height - 56px; width: parent.width;
            AboutView {
                pcsx2-version: root.pcsx2-version;
                back-clicked => { settings-page = 0; }
                open-url(url) => { root.open-external-url(url); }
            }
        }
        Rectangle {
            x: settings-page == 17 ? 0px : parent.width;
            animate x { duration: 300ms; easing: ease-in-out; }
            y: 56px; height: parent.height - 56px; width: parent.width;
            LogViewerView {
                log-lines: root.log-lines;
                back-clicked => { settings-page = 0; }
                clear-log => { root.clear-log(); }
            }
        }
        Rectangle {
            x: settings-page == 20 ? 0px : parent.width;
            animate x { duration: 300ms; easing: ease-in-out; }
            y: 56px; height: parent.height - 56px; width: parent.width;
            ControllerBindingView { back-clicked => { settings-page = 2; } }
        }
        Rectangle {
            x: settings-page == 21 ? 0px : parent.width;
            animate x { duration: 300ms; easing: ease-in-out; }
            y: 56px; height: parent.height - 56px; width: parent.width;
            HotkeySettingsView {
                hotkeys: root.hotkeys;
                capturing: root.hotkey-capturing;
                capturing-name: root.hotkey-capturing-name;
                back-clicked => { settings-page = 2; }
                capture-requested(name) => { root.hotkey-capture(name); }
                clear-binding(name) => { root.hotkey-clear(name); }
                reload-clicked => { root.hotkey-reload(); }
            }
        }
    Rectangle {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 88px;
        width: (!is-playing && current-tab == 0) ? 56px : 0px;
        height: self.width;
        border-radius: self.width / 2;
        background: primary;
        opacity: (!is-playing && current-tab == 0) ? 1 : 0;
        visible: (!is-playing && current-tab == 0) || self.opacity > 0.01;

        animate width { duration: 200ms; easing: ease-in-out; }
        animate opacity { duration: 150ms; easing: ease-in-out; }

        Image {
            source: @image-url("icons/qt/plus-line.svg");
            colorize: on-primary;
            width: parent.width > 24px ? 24px : parent.width;
            height: self.width;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
        TouchArea { 
            width: 100%; height: 100%; 
            enabled: !is-playing && current-tab == 0; 
            clicked => { root.add-game-folder(); }
        }
    }

    if (!is-playing) : Rectangle {
        y: parent.height - 80px;
        height: 80px; width: parent.width;
        background: bg;
        
        HorizontalLayout {
            width: parent.width; height: parent.height;
            spacing: 0px; padding-top: 12px; padding-bottom: 16px;

            Rectangle {
                width: parent.width / 3;
                VerticalLayout {
                    spacing: 4px; alignment: center;
                    Rectangle { 
                        width: 64px; height: 32px; border-radius: 16px; x: (parent.width - self.width)/2;
                        background: current-tab == 0 ? primary-container : transparent;
                        animate background { duration: 200ms; easing: ease-in-out; }
                        Image {
                            source: @image-url("icons/qt/controller-line.svg");
                            colorize: current-tab == 0 ? on-primary-container : text-variant;
                            width: 20px; height: 20px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            animate colorize { duration: 200ms; }
                        }
                    }
                    Text { text: "Games"; color: current-tab == 0 ? text-main : text-muted; font-size: 12px; font-weight: 500; horizontal-alignment: center; animate color { duration: 200ms; } }
                }
                TouchArea { width: 100%; height: 100%; clicked => { settings-page = 0; current-tab = 0; } }
            }

            Rectangle {
                width: parent.width / 3;
                VerticalLayout {
                    spacing: 4px; alignment: center;
                    Rectangle { 
                        width: 64px; height: 32px; border-radius: 16px; x: (parent.width - self.width)/2;
                        background: current-tab == 1 ? primary-container : transparent;
                        animate background { duration: 200ms; easing: ease-in-out; }
                        Image {
                            source: @image-url("icons/qt/save-3-line.svg");
                            colorize: current-tab == 1 ? on-primary-container : text-variant;
                            width: 20px; height: 20px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            animate colorize { duration: 200ms; }
                        }
                    }
                    Text { text: "States"; color: current-tab == 1 ? text-main : text-muted; font-size: 12px; font-weight: 500; horizontal-alignment: center; animate color { duration: 200ms; } }
                }
                TouchArea { width: 100%; height: 100%; clicked => { settings-page = 0; current-tab = 1; } }
            }

            Rectangle {
                width: parent.width / 3;
                VerticalLayout {
                    spacing: 4px; alignment: center;
                    Rectangle { 
                        width: 64px; height: 32px; border-radius: 16px; x: (parent.width - self.width)/2;
                        background: current-tab == 2 ? primary-container : transparent;
                        animate background { duration: 200ms; easing: ease-in-out; }
                        Image {
                            source: @image-url("icons/qt/settings-3-line.svg");
                            colorize: current-tab == 2 ? on-primary-container : text-variant;
                            width: 20px; height: 20px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            animate colorize { duration: 200ms; }
                        }
                    }
                    Text { text: "Settings"; color: current-tab == 2 ? text-main : text-muted; font-size: 12px; font-weight: 500; horizontal-alignment: center; animate color { duration: 200ms; } }
                }
                TouchArea { width: 100%; height: 100%; clicked => { settings-page = 0; current-tab = 2; } }
            }
        }

        // Debug page (hidden by default, accessible via F12 or debug button)
        if current-tab == 3: DebugPage {
            visible: true;
        }
    }
}
}
