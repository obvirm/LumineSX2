// Symbol Tree Widget
export component SymbolTreeWidget inherits Rectangle {
    in-out property <int> selected-cpu: 0;
    in-out property <string> filter-text: "";
    in-out property <int> tree-depth: 0;

    background: MaterialColors.surface;

    VerticalLayout {
        Rectangle {
            height: 56px;
            background: MaterialColors.surface-container;

            VerticalLayout {
                padding: 8px;
                spacing: 4px;

                HorizontalLayout {
                    spacing: 8px;
                    for cpu[idx] in ["EE", "IOP"]: Rectangle {
                        width: 48px;
                        height: 24px;
                        background: selected-cpu == idx ? MaterialColors.primary-container : MaterialColors.surface-container-high;
                        border-radius: 4px;

                        Text {
                            text: cpu;
                            color: selected-cpu == idx ? MaterialColors.on-primary-container : MaterialColors.on-surface-variant;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            clicked => { selected-cpu = idx; }
                        }
                    }
                }

                LineEdit {
                    text: filter-text;
                    placeholder-text: "Filter symbols...";
                    font-size: 11px;
                    height: 24px;
                }
            }
        }

        // Tree placeholder
        ScrollView {
            for i in 20: Rectangle {
                height: 20px;
                background: i % 2 == 0 ? MaterialColors.surface-container-low : Colors.transparent;

                HorizontalLayout {
                    padding-left: 8px + (i % 3) * 16px;
                    spacing: 4px;

                    Text {
                        text: i % 3 == 0 ? "📁" : (i % 3 == 1 ? "📂" : "🔗");
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: i % 3 == 0 ? "function_" + i : (i % 3 == 1 ? "struct_" + i : "var_" + i);
                        color: MaterialColors.on-surface;
                        font-size: 11px;
                        font-family: "Consolas";
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// Dock Manager
export component DockManager inherits Rectangle {
    in-out property <[string]> layouts: ["Default", "Compact", "Full", "Custom 1"];
    in-out property <int> selected-layout: 0;
    in-out property <bool> layout-locked: false;
    in-out property <int> selected-cpu: 0;
    callback save-layout();
    callback delete-layout();
    callback rename-layout();

    background: MaterialColors.surface;

    VerticalLayout {
        Rectangle {
            height: 32px;
            background: MaterialColors.surface-container;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;

                Text {
                    text: "Layout:";
                    color: MaterialColors.on-surface-variant;
                    font-size: 11px;
                    vertical-alignment: center;
                }

                ComboBox {
                    model: layouts;
                    current-index: selected-layout;
                    selected => { selected-layout = self.current-index; }
                }

                Button { text: "Save"; clicked => { save-layout(); } }
                Button { text: "Rename"; clicked => { rename-layout(); } }
                Button { text: "Delete"; clicked => { delete-layout(); } }
                Button { text: "Reset"; clicked => { } }

                Rectangle { horizontal-stretch: 1; }

                // Lock toggle
                Rectangle {
                    width: 64px;
                    height: 24px;
                    background: layout-locked ? MaterialColors.error-container : MaterialColors.surface-container-high;
                    border-radius: 4px;

                    Text {
                        text: layout-locked ? "🔒 Locked" : "🔓 Edit";
                        color: layout-locked ? MaterialColors.on-error-container : MaterialColors.on-surface-variant;
                        font-size: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => { layout-locked = !layout-locked; }
                    }
                }
            }
        }
    }
}
