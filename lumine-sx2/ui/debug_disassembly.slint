import { ScrollView, VerticalBox, HorizontalBox, LineEdit, Button } from "std-widgets.slint";

// ─── Disassembly Structs ───
export struct DisassemblyLine {
    address: string,
    address-raw: int,
    hex-bytes: string,
    mnemonic: string,
    params: string,
    comment: string,
    full-text: string,
    // State flags
    has-breakpoint: bool,
    breakpoint-enabled: bool,
    is-selected: bool,
    is-selection-start: bool,
    is-selection-end: bool,
    is-current-pc: bool,
    is-branch: bool,
    has-relevant-address: bool,
    branch-target: int,
    // Function info
    function-name: string,
    is-function-start: bool,
    function-color-r: int,
    function-color-g: int,
    function-color-b: int,
}

export struct BranchLine {
    from-address: int,
    to-address: int,
    from-row: int,
    to-row: int,
    is-up: bool,
    is-selected: bool,
    column: int,
}

// ─── Disassembly View ───
export component DisassemblyView inherits Rectangle {
    // Data
    in property <[DisassemblyLine]> lines: [];
    in property <[BranchLine]> branch-lines: [];
    in property <string> title-line: "";
    in property <int> title-color-r: 137;
    in property <int> title-color-g: 180;
    in property <int> title-color-b: 250;
    in property <string> current-pc: "0x00000000";
    in property <int> visible-start: 1048576;
    in property <int> visible-rows: 50;
    in property <int> row-height: 20;
    in property <bool> show-instruction-bytes: true;
    in property <bool> go-to-pc-on-pause: true;
    // Selection
    in property <int> selected-address-start: 0;
    in property <int> selected-address-end: 0;
    // Interaction callbacks
    callback entry-clicked(int /*address*/, bool /*shift*/);
    callback entry-double-clicked(int /*address*/);
    callback context-menu(int /*address*/, length /*x*/, length /*y*/);
    callback scroll-by(int /*delta-instructions*/);
    callback go-to-address(string /*address*/);
    callback go-to-pc();
    callback follow-branch(int /*address*/);
    callback toggle-breakpoint(int /*address*/);
    callback toggle-show-bytes();
    callback key-pressed(string /*key*/);
    // Focus
    in property <bool> has-focus: false;
    // ─── Title Line ───
    Rectangle {
        y: 0;
        height: root.row-height * 1px;
        background: rgb(root.title-color-r, root.title-color-g, root.title-color-b);
        clip: true;

        Text {
            x: 4px;
            text: root.title-line;
            color: #11111b;
            font-size: 11px;
            font-family: "Cascadia Code";
            font-weight: 700;
            vertical-alignment: center;
        }
    }
    // ─── Separator ───
    Rectangle {
        y: root.row-height * 1px;
        height: 1px;
        background: #313244;
    }
    // ─── Disassembly Rows ───
    Flickable {
        y: (root.row-height + 1) * 1px;
        height: parent.height - (root.row-height + 1) * 1px - 28px;
        viewport-height: lines.length * root.row-height * 1px;

        for line[idx] in lines: Rectangle {
            y: idx * root.row-height * 1px;
            height: root.row-height * 1px;
            background: line.is-selected ? #3b3f54 : (line.is-current-pc ? #1e3a5f : (Math.mod(idx, 2) == 0 ? transparent : #181825));
            clip: true;

            // Current PC indicator (left border)
            if line.is-current-pc: Rectangle {
                x: 0;
                width: 3px;
                height: parent.height;
                background: #89b4fa;
            }

            // Selection range indicator
            if line.is-selected && !line.is-current-pc: Rectangle {
                x: 0;
                width: 2px;
                height: parent.height;
                background: #f38ba8;
            }

            // Breakpoint indicator
            if line.has-breakpoint: Rectangle {
                x: 4px;
                y: (parent.height - 10px) / 2;
                width: 10px;
                height: 10px;
                border-radius: 2px;
                background: line.breakpoint-enabled ? #a6e3a1 : #f9e2af;
            }

            // Function start indicator
            if line.is-function-start: Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 1px;
                background: #45475a;
            }

            // Instruction text
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 8px;
                spacing: 0;

                // Address
                Text {
                    text: line.address;
                    color: line.is-current-pc ? #89b4fa : (line.is-function-start ? rgb(line.function-color-r, line.function-color-g, line.function-color-b) : #cdd6f4);
                    font-size: 12px;
                    font-family: "Cascadia Code";
                    vertical-alignment: center;
                    width: 90px;
                }

                // Hex bytes (if enabled)
                if root.show-instruction-bytes: Text {
                    text: line.hex-bytes;
                    color: #585b70;
                    font-size: 12px;
                    font-family: "Cascadia Code";
                    vertical-alignment: center;
                    width: 100px;
                }

                // Mnemonic
                Text {
                    text: line.mnemonic;
                    color: line.is-branch ? #f38ba8 : (line.is-current-pc ? #a6e3a1 : #cba6f7);
                    font-size: 12px;
                    font-family: "Cascadia Code";
                    vertical-alignment: center;
                    width: 80px;
                }

                // Parameters
                Text {
                    text: line.params;
                    color: line.has-relevant-address ? #89b4fa : #cdd6f4;
                    font-size: 12px;
                    font-family: "Cascadia Code";
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                // Comment
                if line.comment != "": Text {
                    text: "; " + line.comment;
                    color: #6c7086;
                    font-size: 12px;
                    font-family: "Cascadia Code";
                    vertical-alignment: center;
                    width: 120px;
                    overflow: elide;
                }
            }

            // Mouse interaction
            TouchArea {
                clicked => {
                    root.entry-clicked(line.address-raw, false);
                }
                double-clicked => {
                    root.entry-double-clicked(line.address-raw);
                }
            }

            // Branch arrows (simplified - column indicator on right)
            if line.is-branch: Rectangle {
                x: parent.width - 20px;
                y: (parent.height - 8px) / 2;
                width: 8px;
                height: 8px;
                background: line.is-selected ? #89b4fa : #f38ba8;
                border-radius: 2px;
            }
        }
    }

    // ─── Branch Lines Overlay (right side) ───
    for branch[idx] in branch-lines: Rectangle {
        x: parent.width - 30px - (branch.column * 10px);
        y: (root.row-height + 1) * 1px + (branch.is-up ? branch.to-row : branch.from-row) * root.row-height * 1px;
        width: 4px;
        height: Math.abs(branch.to-row - branch.from-row) * root.row-height * 1px;
        background: branch.is-selected ? #89b4fa : #f38ba8;
        opacity: 0.6;
    }

    // ─── Go To Address Bar ───
    Rectangle {
        y: parent.height - 28px;
        height: 28px;
        background: #1e1e2e;
        border-width: 1px;
        border-color: #313244;

        HorizontalLayout {
            padding: 4px;
            spacing: 4px;

            Text {
                text: "Go to:";
                color: #cdd6f4;
                font-size: 11px;
                vertical-alignment: center;
            }

            addr-input := LineEdit {
                placeholder-text: "0x00000000";
                font-size: 11px;
                horizontal-stretch: 1;
                accepted => {
                    root.go-to-address(addr-input.text);
                }
            }

            Button {
                text: "PC";
                clicked => { root.go-to-pc(); }
            }
        }
    }

    // ─── Keyboard Handler ───
    FocusScope {
        key-pressed(event) => {
            if (event.text == "g") { root.key-pressed("goto"); }
            else if (event.text == "j") { root.key-pressed("jump"); }
            else if (event.text == "c") { root.key-pressed("copy"); }
            else if (event.text == "b" || event.text == " ") { root.key-pressed("breakpoint"); }
            else if (event.text == "m") { root.key-pressed("assemble"); }
            else if (event.text == "i") { root.toggle-show-bytes(); }
            else if (event.text == "ArrowUp") { root.scroll-by(-1); }
            else if (event.text == "ArrowDown") { root.scroll-by(1); }
            else if (event.text == "PageUp") { root.scroll-by(-root.visible-rows); }
            else if (event.text == "PageDown") { root.scroll-by(root.visible-rows); }
            else if (event.text == "ArrowRight") { root.key-pressed("follow"); }
            else if (event.text == "ArrowLeft") { root.go-to-pc(); }
            accept
        }
    }
}
