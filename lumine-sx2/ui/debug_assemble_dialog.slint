import { Button, HorizontalBox, VerticalBox, LineEdit } from "std-widgets.slint";

// ─── Assemble Instruction Dialog ───
export component AssembleDialog inherits Rectangle {
    in property <string> address: "0x00000000";
    in property <string> current-instruction: "";
    in property <string> input-value: "";

    callback confirmed(string /*address*/, string /*instruction*/);
    callback cancelled();

    background: #11111b;

    Rectangle {
        width: 400px;
        height: 180px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: #1e1e2e;
        border-radius: 8px;
        border-width: 1px;
        border-color: #313244;

        VerticalBox {
            padding: 16px;
            spacing: 12px;

            Text {
                text: "Assemble Instruction";
                color: #cdd6f4;
                font-size: 14px;
                font-weight: 700;
            }

            // Address
            Text {
                text: "At: " + root.address;
                color: #6c7086;
                font-size: 11px;
            }

            // Current instruction
            if current-instruction != "": Text {
                text: "Current: " + root.current-instruction;
                color: #cdd6f4;
                font-size: 11px;
                font-family: "Cascadia Code", "Consolas", monospace;
            }

            // Input
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "MIPS:";
                    color: #cdd6f4;
                    font-size: 11px;
                    vertical-alignment: center;
                    width: 50px;
                }
                LineEdit {
                    text: root.input-value;
                    placeholder-text: "e.g. nop, addiu a0, a1, 0x10";
                    font-size: 11px;
                    font-family: "Cascadia Code", "Consolas", monospace;
                    horizontal-stretch: 1;
                    accepted => { root.confirmed(root.address, root.input-value); }
                }
            }

            // Buttons
            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: "Cancel";
                    clicked => { root.cancelled(); }
                    min-width: 80px;
                }
                Button {
                    text: "Assemble";
                    clicked => { root.confirmed(root.address, root.input-value); }
                    min-width: 80px;
                }
            }
        }
    }
}
