import { HorizontalBox, VerticalBox, LineEdit } from "std-widgets.slint";

export struct SymbolEntry {
    name: string,
    address: string,
    type: string,
    size: string,
    is-function: bool,
    is-selected: bool,
}

export component SymbolView inherits Rectangle {
    in property <[SymbolEntry]> entries: [];
    in property <string> filter: "";
    callback entry-selected(int);
    callback entry-double-clicked(int);
    callback filter-changed(string);

    background: #11111b;

    VerticalBox {
        padding: 0;
        spacing: 0;

        Rectangle {
            height: 32px;
            background: #181825;
            HorizontalLayout {
                padding: 4px;
                LineEdit {
                    text: root.filter;
                    placeholder-text: "Filter symbols...";
                    font-size: 11px;
                    edited(t) => { root.filter-changed(t); }
                }
            }
        }
        Rectangle { height: 1px; background: #313244; }

        Rectangle {
            height: 24px;
            background: #181825;
            HorizontalLayout {
                padding: 4px;
                Text { text: "Name"; color: #89b4fa; font-size: 10px; font-weight: 600; horizontal-stretch: 1; }
                Text { text: "Address"; color: #89b4fa; font-size: 10px; font-weight: 600; width: 100px; }
                Text { text: "Type"; color: #89b4fa; font-size: 10px; font-weight: 600; width: 60px; }
                Text { text: "Size"; color: #89b4fa; font-size: 10px; font-weight: 600; width: 60px; }
            }
        }
        Rectangle { height: 1px; background: #313244; }

        Flickable {
            vertical-stretch: 1;
            viewport-height: entries.length * 20px;
            for entry[idx] in entries: Rectangle {
                y: idx * 20px;
                height: 20px;
                background: entry.is-selected ? #3b3f54 : (Math.mod(idx, 2) == 0 ? transparent : #181825);
                TouchArea {
                    clicked => { root.entry-selected(idx); }
                    double-clicked => { root.entry-double-clicked(idx); }
                }
                HorizontalLayout {
                    padding: 2px;
                    padding-left: 4px;
                    Text { text: entry.name; color: entry.is-function ? #89b4fa : #a6e3a1; font-size: 11px; horizontal-stretch: 1; overflow: elide; }
                    Text { text: entry.address; color: #f9e2af; font-size: 11px; font-family: "Cascadia Code"; width: 100px; }
                    Text { text: entry.type; color: #cdd6f4; font-size: 11px; width: 60px; }
                    Text { text: entry.size; color: #6c7086; font-size: 11px; width: 60px; }
                }
            }
        }
    }
}
